# Go binary patch analysis
# --------------------------------------------------------------------------


class Edit:
    __slots__ = ("label", "symbol", "va", "offset", "old", "new")

    def __init__(self, label, symbol, va, offset, old, new):
        self.label = label
        self.symbol = symbol
        self.va = va
        self.offset = offset
        self.old = old
        self.new = new


def _jump_bytes(go, funcs, spec, source_va):
    target = funcs.get(spec["jump"], [])
    if len(target) != 1:
        fail("%s: jump target %s not found exactly once" % (go.elf.path, spec["jump"]))
    displacement = target[0][0] - (source_va + 5)
    if not -(1 << 31) <= displacement < (1 << 31):
        fail("%s: jump target out of range" % go.elf.path)
    return b"\xe9" + struct.pack("<i", displacement)


def analyze_go_specs(go, specs):
    wanted = {spec["symbol"] for spec in specs}
    for spec in specs:
        if "jump" in spec:
            wanted.add(spec["jump"])
    funcs = go.find_functions(wanted)
    edits = []
    states = []
    for spec in specs:
        matches = funcs.get(spec["symbol"], [])
        if len(matches) != 1:
            fail(
                "%s: expected exactly one %s, found %d"
                % (go.elf.path, spec["symbol"], len(matches))
            )
        function_va, function_size = matches[0]
        if function_size <= 0:
            fail("%s: zero-sized function %s" % (go.elf.path, spec["symbol"]))
        body = go.elf.read(function_va, function_size)
        if spec["mode"] == "exact":
            old_offset = None
            old_bytes = None
            for variant in spec["old"]:
                first = body.find(variant)
                if first < 0:
                    continue
                if body.find(variant, first + 1) >= 0:
                    fail(
                        "%s: %s baseline signature is ambiguous"
                        % (go.elf.path, spec["label"])
                    )
                if old_offset is not None:
                    fail(
                        "%s: %s matches more than one baseline variant"
                        % (go.elf.path, spec["label"])
                    )
                old_offset = first
                old_bytes = variant
            new_hits = body.count(spec["new"])
            if old_offset is not None and new_hits == 0:
                states.append("old")
                edits.append(
                    Edit(
                        spec["label"],
                        spec["symbol"],
                        function_va,
                        go.elf.va_to_off(function_va, function_size) + old_offset,
                        old_bytes,
                        spec["new"],
                    )
                )
            elif old_offset is None and new_hits == 1:
                states.append("new")
            else:
                fail(
                    "%s: %s is not in a known state (baseline=%s patched=%d)"
                    % (
                        go.elf.path,
                        spec["label"],
                        "found" if old_offset is not None else "missing",
                        new_hits,
                    )
                )
        else:
            new_bytes = spec.get("new")
            if new_bytes is None:
                new_bytes = _jump_bytes(go, funcs, spec, function_va)
            prologue_ok = any(body.startswith(p) for p in spec["prologue"])
            if prologue_ok and body.startswith(spec["old"]):
                states.append("old")
                edits.append(
                    Edit(
                        spec["label"],
                        spec["symbol"],
                        function_va,
                        go.elf.va_to_off(function_va, function_size),
                        spec["old"],
                        new_bytes,
                    )
                )
            elif body.startswith(new_bytes):
                states.append("new")
            else:
                fail(
                    "%s: %s has unexpected entry bytes %s"
                    % (go.elf.path, spec["symbol"], body[:16].hex())
                )
    if all(state == "old" for state in states):
        state = "pristine"
    elif all(state == "new" for state in states):
        state = "patched"
    else:
        fail(
            "%s: mixed patch state (%s)"
            % (
                go.elf.path,
                ", ".join(
                    "%s=%s" % (spec["symbol"].rsplit(".", 1)[-1], state_kind)
                    for spec, state_kind in zip(specs, states)
                ),
            )
        )
    if state == "pristine":
        ordered = sorted(edits, key=lambda edit: edit.offset)
        for previous, current in zip(ordered, ordered[1:]):
            if previous.offset + len(previous.new) > current.offset:
                fail("%s: overlapping patch sites" % go.elf.path)
    return state, edits, funcs


