def _repo_root():
    return os.path.dirname(os.path.realpath(__file__))


def load_zh_assets():
    root = _repo_root()
    dict_path = os.path.join(root, "dicts", "zh-CN.json")
    engine_path = os.path.join(root, "assets", "zh-cn-engine.js")
    if not os.path.exists(dict_path):
        fail("localization dictionary missing: %s" % dict_path)
    if not os.path.exists(engine_path):
        fail("localization engine missing: %s" % engine_path)
    with open(dict_path, "r", encoding="utf-8") as handle:
        dict_payload = json.load(handle)
    with open(engine_path, "r", encoding="utf-8") as handle:
        engine_tpl = handle.read()
    if "__AGY_DICT_JSON__" not in engine_tpl or "__AGY_CORE_WORDS_JSON__" not in engine_tpl:
        fail("localization engine template is missing placeholders: %s" % engine_path)
    engine_js = (
        engine_tpl.replace(
            "__AGY_DICT_JSON__",
            json.dumps(dict_payload["dictionary"], ensure_ascii=False),
        ).replace(
            "__AGY_CORE_WORDS_JSON__",
            json.dumps(dict_payload["coreWords"], ensure_ascii=False),
        )
    )
    return dict_payload, engine_js


