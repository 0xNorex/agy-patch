def _zh_status(asar_path):
    digest = sha256_file(asar_path)
    archive = AsarArchive(asar_path)
    state, _replacements, summary = analyze_asar_zh(archive, engine_js=None)
    print("[desktop-zh]")
    print("asar:     %s" % asar_path)
    print("app:      Antigravity %s" % summary["app_version"])
    print("sha256:   %s" % digest)
    if state == "pristine":
        print("state:    pristine (%s; not patched)" % (
            "verified " + KNOWN_ASAR_BUILDS[digest] if digest in KNOWN_ASAR_BUILDS
            else "anchor-compatible, UNVERIFIED build"
        ))
    else:
        print("state:    patched (zh-CN DOM engine + %d native UI edits)" % summary["native_edits"])
    _print_manifest_status(state_directory(), asar_path, state, digest)


def _zh_apply(desktop_dir, asar_path, dry_run):
    source_stat = os.lstat(asar_path)
    current_sha = sha256_file(asar_path)
    state_dir = state_directory()
    manifest = load_manifest(state_dir, asar_path)

    archive = AsarArchive(asar_path)
    dict_payload, engine_js = load_zh_assets()
    state, replacements, summary = analyze_asar_zh(archive, engine_js=engine_js)

    print("[desktop-zh]")
    if state == "patched":
        if manifest is None:
            fail("%s: app.asar is already patched but the manifest is missing; refusing to continue" % asar_path)
        if current_sha != manifest.get("patched_sha256"):
            fail("%s: app.asar is patched but does not match the manifest; refusing to continue" % asar_path)
        print("already patched: %s" % asar_path)
        print("sha256:          %s (matches manifest)" % current_sha)
        return
    if current_sha not in KNOWN_ASAR_BUILDS:
        fail("%s: unverified original SHA256 %s; refusing unknown build" % (asar_path, current_sha))
    if manifest is not None and manifest.get("original_sha256") != current_sha:
        print("warning: an older manifest exists for a different build; it will be replaced")

    if not dry_run:
        check_desktop_not_running(desktop_dir)

    print("asar:     %s" % asar_path)
    print("app:      Antigravity %s" % summary["app_version"])
    print(
        "dict:     %d entries + %d core words"
        % (len(dict_payload["dictionary"]), len(dict_payload["coreWords"]))
    )
    print(
        "edits:    2 preload injections + %d native Electron UI replacements (%d files)"
        % (summary["native_edits"], summary["injected_files"])
    )
    if dry_run:
        print("sha256:   %s (dry-run; no files were written)" % current_sha)
        return

    backup_path = ensure_backup(asar_path, state_dir, current_sha, source_stat, ext=".asar")
    print("backup:   %s (sha256 verified)" % backup_path)

    directory = os.path.dirname(asar_path)
    temp_path = temp_in_dir(directory, ".app-asar-")
    try:
        archive.rewrite(temp_path, replacements, source_stat)
        patched_sha = sha256_file(temp_path)
        verify_archive = AsarArchive(temp_path)
        verify_state, _, _ = analyze_asar_zh(verify_archive, engine_js=None)
        if verify_state != "patched":
            fail("rewritten app.asar failed post-pack verification")
        assert_unchanged(asar_path, source_stat, current_sha)
        os.replace(temp_path, asar_path)
        fsync_dir(directory)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)

    final_sha = sha256_file(asar_path)
    if final_sha != patched_sha:
        fail("%s: post-write checksum mismatch (%s)" % (asar_path, final_sha))

    manifest_payload = {
        "schema": 1,
        "tool": "agy-patch",
        "target": "desktop-zh",
        "binary": asar_path,
        "app_version": summary["app_version"],
        "binary_size": source_stat.st_size,
        "original_sha256": current_sha,
        "patched_sha256": patched_sha,
        "backup": backup_path,
        "backup_sha256": current_sha,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "dict_entries": len(dict_payload["dictionary"]),
        "native_edits": summary["native_edits"],
    }
    atomic_write_json(manifest_path(state_dir, asar_path), manifest_payload)
    print("sha256:   %s -> %s" % (current_sha, patched_sha))
    print("patched:  %s" % asar_path)
    print("manifest: %s" % manifest_path(state_dir, asar_path))


