# hashing / atomic file helpers
# --------------------------------------------------------------------------


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        while True:
            block = handle.read(CHUNK)
            if not block:
                break
            digest.update(block)
    return digest.hexdigest()


def sha256_with_edits(path, edits):
    """Hash the file as if ``edits`` (offset, new_bytes) had been applied."""

    digest = hashlib.sha256()
    ordered = sorted((edit.offset, edit.new) for edit in edits)
    with open(path, "rb") as handle:
        position = 0
        for offset, new in ordered:
            while position < offset:
                block = handle.read(min(CHUNK, offset - position))
                if not block:
                    fail("%s: unexpected end of file while hashing" % path)
                digest.update(block)
                position += len(block)
            digest.update(new)
            handle.seek(offset + len(new))
            position = offset + len(new)
        while True:
            block = handle.read(CHUNK)
            if not block:
                break
            digest.update(block)
    return digest.hexdigest()


def _copy_range(source, target, count):
    while count > 0:
        block = source.read(min(CHUNK, count))
        if not block:
            fail("unexpected end of file while writing patched binary")
        target.write(block)
        count -= len(block)


def write_patched(source_path, target_path, edits, source_stat):
    ordered = sorted((edit.offset, edit.new) for edit in edits)
    with open(source_path, "rb") as source, open(target_path, "wb") as target:
        position = 0
        for offset, new in ordered:
            _copy_range(source, target, offset - position)
            target.write(new)
            source.seek(offset + len(new))
            position = offset + len(new)
        _copy_range(source, target, os.fstat(source.fileno()).st_size - position)
        target.flush()
        os.fsync(target.fileno())
    os.chmod(target_path, stat.S_IMODE(source_stat.st_mode))
    try:
        os.chown(target_path, source_stat.st_uid, source_stat.st_gid)
    except (PermissionError, AttributeError):
        pass


def fsync_dir(path):
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def temp_in_dir(directory, prefix):
    fd, path = tempfile.mkstemp(dir=directory, prefix=prefix, suffix=".tmp")
    os.close(fd)
    return path


def atomic_write_json(path, payload):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    temp_path = temp_in_dir(directory, ".manifest-")
    try:
        with open(temp_path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, path)
        fsync_dir(directory)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)


