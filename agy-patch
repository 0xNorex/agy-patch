def resolve_binary(argument, allow_symlink):
    if argument:
        path = os.path.abspath(argument)
    else:
        found = shutil.which("agy")
        if not found:
            fail("agy was not found in PATH; pass --binary PATH")
        path = os.path.abspath(found)
    if not os.path.lexists(path):
        fail("%s: no such file" % path)
    if os.path.islink(path) and not allow_symlink:
        fail(
            "%s is a symlink; pass --binary pointing at the real file "
            "(symlinks are not patched in place)" % path
        )
    if not os.path.isfile(path):
        fail("%s: not a regular file" % path)
    return path, os.path.realpath(path)


def _is_desktop_dir(path):
    if not path or not os.path.isdir(path):
        return False
    return (
        os.path.isfile(os.path.join(path, "resources", "app.asar"))
        and os.path.isfile(os.path.join(path, "resources", "bin", "language_server"))
    )


def resolve_desktop_dir(argument):
    if argument:
        cand = os.path.abspath(argument)
        if _is_desktop_dir(cand):
            return os.path.realpath(cand)
        parent = os.path.dirname(cand)
        if os.path.basename(cand) == "resources" and _is_desktop_dir(parent):
            return os.path.realpath(parent)
        fail("%s: not an Antigravity Desktop directory (missing resources/app.asar or resources/bin/language_server)" % cand)

    candidates = [
        os.path.expanduser("~/.local/opt/antigravity"),
        "/opt/antigravity",
        "/opt/Antigravity",
        "/usr/lib/antigravity",
        "/usr/share/antigravity",
    ]
    which_ag = shutil.which("antigravity")
    if which_ag:
        real_ag = os.path.realpath(which_ag)
        candidates.insert(0, os.path.dirname(real_ag))
        if os.path.isfile(real_ag) and os.path.getsize(real_ag) < 16384:
            try:
                with open(real_ag, "r", encoding="utf-8", errors="ignore") as f:
                    txt = f.read()
                for line in txt.splitlines():
                    if "APP_DIR=" in line and '"' in line:
                        val = line.split('"', 2)[1].replace("$HOME", os.path.expanduser("~"))
                        candidates.insert(0, val)
            except OSError:
                pass
    for cand in candidates:
        if _is_desktop_dir(cand):
            return os.path.realpath(cand)
    fail("Antigravity Desktop was not found; pass --desktop-dir PATH")


def expand_targets(args):
    target = args.target
    if target == "auto":
        if args.binary:
            return ["cli"]
        if args.desktop_dir:
            return ["desktop-context", "desktop-zh"]
        selected = []
        if shutil.which("agy"):
            selected.append("cli")
        try:
            resolve_desktop_dir(None)
            selected.extend(["desktop-context", "desktop-zh"])
        except PatchError:
            pass
        if not selected:
            fail("neither agy CLI nor Antigravity Desktop was found; pass --binary or --desktop-dir")
        return selected
    if target == "cli":
        return ["cli"]
    if target == "desktop-context":
        return ["desktop-context"]
    if target == "desktop-zh":
        return ["desktop-zh"]
    if target == "desktop":
        return ["desktop-context", "desktop-zh"]
    if target == "all":
        return ["cli", "desktop-context", "desktop-zh"]
    fail("unknown target: %s" % target)


