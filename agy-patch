def _add_common_args(subparser):
    subparser.add_argument(
        "--target",
        choices=["auto", "cli", "desktop-context", "desktop-zh", "desktop", "all"],
        default="auto",
        help="target component(s) to operate on (default: auto)",
    )
    subparser.add_argument("--binary", help="path to agy CLI binary (default: agy in PATH)")
    subparser.add_argument(
        "--desktop-dir",
        help="path to Antigravity Desktop directory (default: auto-detect)",
    )


def build_parser():
    parser = argparse.ArgumentParser(
        prog="agy-patch",
        description=(
            "Reversible patcher for Antigravity CLI (agy) and Desktop (Linux x86-64): "
            "1M-class context / no auto-compaction + Simplified Chinese Desktop localization."
        ),
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    status = subparsers.add_parser("status", help="show target and patch state")
    _add_common_args(status)
    status.set_defaults(func=command_status)

    apply_parser = subparsers.add_parser("apply", help="verify and patch target(s)")
    _add_common_args(apply_parser)
    apply_parser.add_argument(
        "--dry-run", action="store_true", help="verify and report without writing"
    )
    apply_parser.set_defaults(func=command_apply)

    restore = subparsers.add_parser("restore", help="restore backed-up original file(s)")
    _add_common_args(restore)
    restore.set_defaults(func=command_restore)
    return parser


def main(argv):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except PatchError as error:
        print("error: %s" % error, file=sys.stderr)
        return 1
    except OSError as error:
        print("error: %s" % error, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        return 130
    except Exception:  # pragma: no cover - defensive, keeps failures closed
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
