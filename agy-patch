# ASAR reader & lossless rewriter (zero dependencies)
# --------------------------------------------------------------------------


def _asar_integrity(raw_bytes):
    full_hash = hashlib.sha256(raw_bytes).hexdigest()
    blocks = []
    if not raw_bytes:
        blocks.append(full_hash)
    else:
        for off in range(0, len(raw_bytes), ASAR_BLOCK_SIZE):
            blocks.append(hashlib.sha256(raw_bytes[off : off + ASAR_BLOCK_SIZE]).hexdigest())
    return {
        "algorithm": "SHA256",
        "hash": full_hash,
        "blockSize": ASAR_BLOCK_SIZE,
        "blocks": blocks,
    }


class AsarArchive:
    """In-memory ASAR reader and selective-rewrite packer (preserves unpacked entries)."""

    def __init__(self, path):
        self.path = path
        with open(path, "rb") as handle:
            prefix = handle.read(16)
            if len(prefix) != 16:
                fail("%s: truncated ASAR header" % path)
            u0, u1, u2, u3 = ASAR_PICKLE_HEADER.unpack(prefix)
            if u0 != 4 or u1 < 8 or u2 != u1 - 4 or u3 > u2 - 4:
                fail("%s: invalid ASAR pickle header" % path)
            self.data_offset = 8 + u1
            header_bytes = handle.read(u3)
            if len(header_bytes) != u3:
                fail("%s: truncated ASAR JSON directory" % path)
        try:
            self.header = json.loads(header_bytes.decode("utf-8"))
        except (UnicodeDecodeError, ValueError) as error:
            fail("%s: malformed ASAR JSON header (%s)" % (path, error))
        if not isinstance(self.header, dict) or "files" not in self.header:
            fail("%s: invalid ASAR root node" % path)

    def _lookup(self, rel_path):
        node = self.header
        for part in rel_path.split("/"):
            files = node.get("files")
            if not isinstance(files, dict) or part not in files:
                return None
            node = files[part]
        return node

    def read_bytes(self, rel_path):
        node = self._lookup(rel_path)
        if node is None or "files" in node or node.get("unpacked"):
            return None
        size = int(node["size"])
        offset = int(node["offset"])
        with open(self.path, "rb") as handle:
            handle.seek(self.data_offset + offset)
            data = handle.read(size)
        if len(data) != size:
            fail("%s: truncated ASAR entry %s" % (self.path, rel_path))
        return data

    def read_text(self, rel_path):
        raw = self.read_bytes(rel_path)
        if raw is None:
            return None
        try:
            return raw.decode("utf-8")
        except UnicodeDecodeError:
            fail("%s: non-UTF-8 ASAR entry %s" % (self.path, rel_path))

    def rewrite(self, target_path, replacements, source_stat):
        """Write a new ASAR replacing packed files in replacements (rel_path -> bytes)."""
        pending = dict(replacements)
        file_plan = []
        cursor = [0]

        def clone_tree(node, prefix):
            if "files" in node:
                out_files = {}
                for name, child in node["files"].items():
                    child_path = f"{prefix}/{name}" if prefix else name
                    out_files[name] = clone_tree(child, child_path)
                return {"files": out_files}
            entry = {}
            if node.get("executable"):
                entry["executable"] = True
            if node.get("unpacked"):
                if prefix in pending:
                    fail("%s: refusing to rewrite unpacked ASAR entry %s" % (self.path, prefix))
                entry["size"] = int(node["size"])
                entry["unpacked"] = True
                if "integrity" in node:
                    entry["integrity"] = node["integrity"]
                return entry

            if prefix in pending:
                raw = pending.pop(prefix)
                size = len(raw)
                entry["size"] = size
                entry["offset"] = str(cursor[0])
                entry["integrity"] = _asar_integrity(raw)
                file_plan.append(("replace", raw, size))
                cursor[0] += size
            else:
                size = int(node["size"])
                src_off = int(node["offset"])
                entry["size"] = size
                entry["offset"] = str(cursor[0])
                if "integrity" in node:
                    entry["integrity"] = node["integrity"]
                file_plan.append(("copy", src_off, size))
                cursor[0] += size
            return entry

        new_header = clone_tree(self.header, "")
        if pending:
            fail("%s: missing ASAR entries for replacement: %s" % (self.path, ", ".join(sorted(pending))))

        header_json = json.dumps(new_header, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
        pad_len = (-len(header_json)) % 4
        padded_len = len(header_json) + pad_len
        pickle_bytes = ASAR_PICKLE_HEADER.pack(4, padded_len + 8, padded_len + 4, len(header_json))

        with open(self.path, "rb") as src, open(target_path, "wb") as dst:
            dst.write(pickle_bytes)
            dst.write(header_json)
            if pad_len:
                dst.write(b"\x00" * pad_len)
            for kind, arg, size in file_plan:
                if kind == "replace":
                    dst.write(arg)
                else:
                    src.seek(self.data_offset + arg)
                    _copy_range(src, dst, size)
            dst.flush()
            os.fsync(dst.fileno())
        os.chmod(target_path, stat.S_IMODE(source_stat.st_mode))
        try:
            os.chown(target_path, source_stat.st_uid, source_stat.st_gid)
        except (PermissionError, AttributeError):
            pass


