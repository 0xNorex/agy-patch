def _check_specs():
    if struct.pack("<I", UI_CONTEXT_CAP) != b"\x00\x00\x0f\x00":
        raise AssertionError("internal patch table error: UI cap encoding")
    for spec in CLI_PATCH_SPECS:
        if spec["mode"] == "exact":
            for variant in spec["old"]:
                if len(variant) != len(spec["new"]):
                    raise AssertionError("internal patch table error: %s" % spec["label"])
        elif "new" in spec:
            if len(spec["new"]) != len(spec["old"]):
                raise AssertionError("internal patch table error: %s" % spec["label"])
        elif len(spec["old"]) != 5:
            raise AssertionError("internal patch table error: %s" % spec["label"])


_check_specs()


