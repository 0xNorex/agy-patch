# patch analysis
# --------------------------------------------------------------------------


class Edit:
    __slots__ = ("label", "symbol", "va", "offset", "old", "new")

    def __init__(self, label, symbol, va, offset, old, new):
        self.label = label
        self.symbol = symbol
        self.va = va
        self.offset = offset
        self.old = old
        self.new = new


def _jump_bytes(go, funcs, spec, source_va):
    target = funcs.get(spec["jump"], [])
    if len(target) != 1:
        fail("%s: jump target %s not found exactly once" % (go.elf.path, spec["jump"]))
    displacement = target[0][0] - (source_va + 5)
    if not -(1 << 31) <= displacement < (1 << 31):
        fail("%s: jump target out of range" % go.elf.path)
    return b"\xe9" + struct.pack("<i", displacement)


def analyze(go):
    """Return (state, edits, function map) where state is pristine|patched."""

    wanted = {spec["symbol"] for spec in PATCH_SPECS} | {SYM_CONTEXT_WINDOW_CHOICE}
    funcs = go.find_functions(wanted)
    edits = []
    states = []
    for spec in PATCH_SPECS:
        matches = funcs.get(spec["symbol"], [])
        if len(matches) != 1:
            fail(
                "%s: expected exactly one %s, found %d"
                % (go.elf.path, spec["symbol"], len(matches))
            )
        function_va, function_size = matches[0]
        if function_size <= 0:
            fail("%s: zero-sized function %s" % (go.elf.path, spec["symbol"]))
        body = go.elf.read(function_va, function_size)
        if spec["mode"] == "exact":
            old_offset = None
            old_bytes = None
            for variant in spec["old"]:
                first = body.find(variant)
                if first < 0:
                    continue
                if body.find(variant, first + 1) >= 0:
                    fail(
                        "%s: %s baseline signature is ambiguous"
                        % (go.elf.path, spec["label"])
                    )
                if old_offset is not None:
                    fail(
                        "%s: %s matches more than one baseline variant"
                        % (go.elf.path, spec["label"])
                    )
                old_offset = first
                old_bytes = variant
            new_hits = body.count(spec["new"])
            if old_offset is not None and new_hits == 0:
                states.append("old")
                edits.append(
                    Edit(
                        spec["label"],
                        spec["symbol"],
                        function_va,
                        go.elf.va_to_off(function_va, function_size) + old_offset,
                        old_bytes,
                        spec["new"],
                    )
                )
            elif old_offset is None and new_hits == 1:
                states.append("new")
            else:
                fail(
                    "%s: %s is not in a known state (baseline=%s patched=%d)"
                    % (
                        go.elf.path,
                        spec["label"],
                        "found" if old_offset is not None else "missing",
                        new_hits,
                    )
                )
        else:  # head patch
            new_bytes = spec.get("new")
            if new_bytes is None:
                new_bytes = _jump_bytes(go, funcs, spec, function_va)
            prologue_ok = any(body.startswith(p) for p in spec["prologue"])
            if prologue_ok and body.startswith(spec["old"]):
                states.append("old")
                edits.append(
                    Edit(
                        spec["label"],
                        spec["symbol"],
                        function_va,
                        go.elf.va_to_off(function_va, function_size),
                        spec["old"],
                        new_bytes,
                    )
                )
            elif body.startswith(new_bytes):
                states.append("new")
            else:
                fail(
                    "%s: %s has unexpected entry bytes %s"
                    % (go.elf.path, spec["symbol"], body[:16].hex())
                )
    if all(state == "old" for state in states):
        state = "pristine"
    elif all(state == "new" for state in states):
        state = "patched"
    else:
        fail(
            "%s: mixed patch state (%s)"
            % (
                go.elf.path,
                ", ".join(
                    "%s=%s" % (spec["symbol"].rsplit(".", 1)[-1], state_kind)
                    for spec, state_kind in zip(PATCH_SPECS, states)
                ),
            )
        )
    if state == "pristine":
        ordered = sorted(edits, key=lambda edit: edit.offset)
        for previous, current in zip(ordered, ordered[1:]):
            if previous.offset + len(previous.new) > current.offset:
                fail("%s: overlapping patch sites" % go.elf.path)
    return state, edits, funcs


# --------------------------------------------------------------------------
# state directory / manifest / backups
# --------------------------------------------------------------------------


def state_directory():
    override = os.environ.get("AGY_PATCH_STATE_DIR")
    if override:
        return os.path.abspath(override)
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.abspath(os.path.join(base, "agy-patch"))


def manifest_path(state_dir, real_path):
    key = hashlib.sha256(real_path.encode("utf-8")).hexdigest()[:16]
    return os.path.join(state_dir, "manifests", key + ".json")


def load_manifest(state_dir, real_path):
    path = manifest_path(state_dir, real_path)
    if not os.path.exists(path):
        return None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            manifest = json.load(handle)
    except (OSError, ValueError) as error:
        fail("%s: unreadable manifest (%s)" % (path, error))
    if manifest.get("schema") != 1:
        fail("%s: unsupported manifest schema" % path)
    if manifest.get("binary") != real_path:
        fail("%s: manifest belongs to another binary" % path)
    manifest["_path"] = path
    return manifest


def ensure_backup(real_path, state_dir, original_sha, source_stat):
    backup_dir = os.path.join(state_dir, "backups")
    os.makedirs(backup_dir, exist_ok=True)
    backup_path = os.path.join(backup_dir, original_sha + ".bin")
    if os.path.exists(backup_path):
        if sha256_file(backup_path) != original_sha:
            fail(
                "%s: existing backup does not match the original binary; "
                "refusing to overwrite it" % backup_path
            )
        return backup_path
    temp_path = temp_in_dir(backup_dir, ".backup-")
    try:
        with open(real_path, "rb") as source, open(temp_path, "wb") as target:
            shutil.copyfileobj(source, target, CHUNK)
            target.flush()
            os.fsync(target.fileno())
        os.chmod(temp_path, stat.S_IMODE(source_stat.st_mode))
        if sha256_file(temp_path) != original_sha:
            fail("backup verification failed (source changed during copy)")
        os.replace(temp_path, backup_path)
        fsync_dir(backup_dir)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)
    return backup_path


def assert_unchanged(real_path, original_stat, original_sha):
    current = os.lstat(real_path)
    for attribute in ("st_dev", "st_ino", "st_size", "st_mtime_ns"):
        if getattr(original_stat, attribute) != getattr(current, attribute):
            fail("%s changed while patching; aborting" % real_path)
    if sha256_file(real_path) != original_sha:
        fail("%s content changed while patching; aborting" % real_path)


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------


def resolve_binary(argument, allow_symlink):
    if argument:
        path = os.path.abspath(argument)
    else:
        found = shutil.which("agy")
        if not found:
            fail("agy was not found in PATH; pass --binary PATH")
        path = os.path.abspath(found)
    if not os.path.lexists(path):
        fail("%s: no such file" % path)
    if os.path.islink(path) and not allow_symlink:
        fail(
            "%s is a symlink; pass --binary pointing at the real file "
            "(symlinks are not patched in place)" % path
        )
    if not os.path.isfile(path):
        fail("%s: not a regular file" % path)
    return path, os.path.realpath(path)


def command_status(args):
    path, real = resolve_binary(args.binary, allow_symlink=True)
    real_stat = os.stat(real)
    digest = sha256_file(real)
    with open(real, "rb") as handle:
        mapping = mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ)
        try:
            elf = ElfImage(real, mapping)
            go = GoImage(elf)
            state, _edits, _funcs = analyze(go)
            summary = go.summary()
        finally:
            mapping.close()

    print("binary:   %s" % real)
    print("sha256:   %s" % digest)
    if real != path:
        print("symlink:  %s -> %s" % (path, real))
    print(
        "go table: %d functions, %d files, text=%s, etext=%s"
        % (
            summary["functions"],
            summary["files"],
            summary["text"],
            summary["etext"],
        )
    )
    if state == "pristine":
        print("state:    pristine (%s; not patched)" % (
            "verified agy " + KNOWN_BUILDS[digest] if digest in KNOWN_BUILDS
            else "signature-compatible, UNVERIFIED build"
        ))
    else:
        print("state:    patched (%d byte edits present)" % len(PATCH_SPECS))

    state_dir = state_directory()
    manifest = load_manifest(state_dir, real)
    if manifest is None:
        print("manifest: none")
        return 0
    print("manifest: %s" % manifest["_path"])
    print("  created: %s" % manifest.get("created_at", "?"))
    if state == "patched":
        if digest == manifest.get("patched_sha256"):
            print("  status:  verified against this build")
        else:
            print("  status:  STALE (binary hash does not match manifest)")
    else:
        print("  status:  stale (binary is not the patched build)")
    backup_path = manifest.get("backup", "")
    if os.path.exists(backup_path):
        if sha256_file(backup_path) == manifest.get("original_sha256"):
            print("backup:   %s (sha256 verified)" % backup_path)
        else:
            print("backup:   %s (CHECKSUM MISMATCH)" % backup_path)
    else:
        print("backup:   %s (missing)" % backup_path)
    print("original: %s" % manifest.get("original_sha256", "?"))
    print("patched:  %s" % manifest.get("patched_sha256", "?"))
    if not os.path.exists(manifest["_path"]):
        print("warning: manifest disappeared during status")
    return 0


def _print_edits(edits):
    for edit in edits:
        print(
            "  %-62s va=0x%x offset=0x%x %s -> %s"
            % (
                edit.symbol.rsplit(".", 1)[-1],
                edit.va,
                edit.offset,
                edit.old.hex(),
                edit.new.hex(),
            )
        )


def command_apply(args):
    path, real = resolve_binary(args.binary, allow_symlink=False)
    source_stat = os.lstat(real)
    current_sha = sha256_file(real)
    state_dir = state_directory()
    manifest = load_manifest(state_dir, real)

    with open(real, "rb") as handle:
        mapping = mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ)
        try:
            elf = ElfImage(real, mapping)
            go = GoImage(elf)
            state, edits, _funcs = analyze(go)
            summary = go.summary()
        finally:
            mapping.close()

    if state == "patched":
        if manifest is None:
            fail(
                "%s: binary is already patched but the manifest is missing; "
                "refusing to continue" % real
            )
        if current_sha != manifest.get("patched_sha256"):
            fail(
                "%s: binary is patched but does not match the manifest; "
                "refusing to continue" % real
            )
        print("already patched: %s" % real)
        print("sha256:          %s (matches manifest)" % current_sha)
        return 0
    if current_sha not in KNOWN_BUILDS:
        fail("%s: unverified original SHA256 %s; refusing unknown build" % (real, current_sha))
    if manifest is not None and manifest.get("original_sha256") != current_sha:
        print(
            "warning: an older manifest exists for a different build; "
            "it will be replaced"
        )

    original_sha = current_sha
    patched_sha = sha256_with_edits(real, edits)
    print("binary:   %s" % real)
    print(
        "go table: %d functions, text=%s"
        % (summary["functions"], summary["text"])
    )
    print("edits:    %d byte replacements" % len(edits))
    _print_edits(edits)
    print("sha256:   %s -> %s" % (original_sha, patched_sha))
    if args.dry_run:
        print("dry-run:  no files were written")
        return 0

    backup_path = ensure_backup(real, state_dir, original_sha, source_stat)
    print("backup:   %s (sha256 verified)" % backup_path)

    directory = os.path.dirname(real)
    temp_path = temp_in_dir(directory, ".agy-patch-")
    try:
        write_patched(real, temp_path, edits, source_stat)
        if sha256_file(temp_path) != patched_sha:
            fail("patched temporary file failed checksum verification")
        assert_unchanged(real, source_stat, original_sha)
        os.replace(temp_path, real)
        fsync_dir(directory)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)

    final_sha = sha256_file(real)
    if final_sha != patched_sha:
        fail("%s: post-write checksum mismatch (%s)" % (real, final_sha))

    manifest_payload = {
        "schema": 1,
        "tool": "agy-patch",
        "binary": real,
        "binary_size": source_stat.st_size,
        "original_sha256": original_sha,
        "patched_sha256": patched_sha,
        "backup": backup_path,
        "backup_sha256": original_sha,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "edits": [
            {
                "label": edit.label,
                "symbol": edit.symbol,
                "va": "0x%x" % edit.va,
                "offset": edit.offset,
                "old": edit.old.hex(),
                "new": edit.new.hex(),
            }
            for edit in edits
        ],
    }
    try:
        atomic_write_json(manifest_path(state_dir, real), manifest_payload)
    except OSError as error:
        print(
            "error: binary was patched but the manifest could not be written: %s"
            % error,
            file=sys.stderr,
        )
        print(
            "       backup: %s\n       original sha256: %s\n"
            "       patched sha256:  %s\n"
            "       restore manually from the backup after verifying its hash."
            % (backup_path, original_sha, patched_sha),
            file=sys.stderr,
        )
        return 1
    print("patched:  %s" % real)
    print("manifest: %s" % manifest_path(state_dir, real))
    print("restore:  agy-patch restore --binary %s" % real)
    return 0


def command_restore(args):
    path, real = resolve_binary(args.binary, allow_symlink=False)
    state_dir = state_directory()
    manifest = load_manifest(state_dir, real)
    if manifest is None:
        fail("%s: no manifest found; nothing to restore" % real)
    live_sha = sha256_file(real)
    if live_sha == manifest.get("original_sha256"):
        fail("%s: binary already matches the original; nothing to restore" % real)
    if live_sha != manifest.get("patched_sha256"):
        fail(
            "%s: live binary hash %s does not match the patched hash in the "
            "manifest; refusing to overwrite a binary changed after patching"
            % (real, live_sha)
        )
    backup_path = manifest.get("backup", "")
    if not os.path.exists(backup_path):
        fail("%s: backup is missing; cannot restore" % backup_path)
    backup_sha = sha256_file(backup_path)
    if backup_sha != manifest.get("original_sha256"):
        fail(
            "%s: backup checksum mismatch (expected %s, got %s); refusing to "
            "restore" % (backup_path, manifest.get("original_sha256"), backup_sha)
        )
    current_stat = os.lstat(real)
    directory = os.path.dirname(real)
    temp_path = temp_in_dir(directory, ".agy-restore-")
    try:
        with open(backup_path, "rb") as source, open(temp_path, "wb") as target:
            shutil.copyfileobj(source, target, CHUNK)
            target.flush()
            os.fsync(target.fileno())
        os.chmod(temp_path, stat.S_IMODE(current_stat.st_mode))
        if sha256_file(temp_path) != backup_sha:
            fail("restored temporary file failed checksum verification")
        assert_unchanged(real, current_stat, live_sha)
        os.replace(temp_path, real)
        fsync_dir(directory)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)
    final_sha = sha256_file(real)
    if final_sha != backup_sha:
        fail("%s: post-restore checksum mismatch" % real)
    try:
        os.unlink(manifest["_path"])
        fsync_dir(os.path.dirname(manifest["_path"]))
    except OSError:
        pass
    print("restored: %s" % real)
    print("sha256:   %s (original)" % final_sha)
    print("backup:   %s (kept)" % backup_path)
    return 0


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------


def build_parser():
    parser = argparse.ArgumentParser(
        prog="agy-patch",
        description=(
            "Patch the Antigravity CLI (agy) for 1M-class context windows. "
            "Reads and rewrites only the agy binary; never touches settings."
        ),
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    status = subparsers.add_parser("status", help="show binary and patch state")
    status.add_argument("--binary", help="path to agy (default: agy in PATH)")
    status.set_defaults(func=command_status)
    apply_parser = subparsers.add_parser("apply", help="verify and patch the binary")
    apply_parser.add_argument("--binary", help="path to agy (default: agy in PATH)")
    apply_parser.add_argument(
        "--dry-run", action="store_true", help="verify and report without writing"
    )
    apply_parser.set_defaults(func=command_apply)
    restore = subparsers.add_parser("restore", help="restore the backed-up binary")
    restore.add_argument("--binary", help="path to agy (default: agy in PATH)")
    restore.set_defaults(func=command_restore)
    return parser


def main(argv):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except PatchError as error:
        print("error: %s" % error, file=sys.stderr)
        return 1
    except OSError as error:
        print("error: %s" % error, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        return 130
    except Exception:  # pragma: no cover - defensive, keeps failures closed
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
