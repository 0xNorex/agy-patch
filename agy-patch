        "dist/preload.js": preload,
        "dist/ideInstall/wizardPreload.js": wizard,
        "dist/menu.js": menu_js,
        "dist/ipcHandlers.js": ipc_js,
    }
    for rel_path, _old, _new, _cnt in ASAR_NATIVE_REPLACEMENTS:
        if rel_path not in files_cache:
            txt = asar_archive.read_text(rel_path)
            if txt is None:
                fail("%s: missing expected ASAR entry %s" % (asar_archive.path, rel_path))
            files_cache[rel_path] = txt

    markers_present = [
        ZH_INJECT_MARKER in preload,
        ZH_INJECT_MARKER in wizard,
        MENU_INJECT_MARKER in menu_js,
        CTX_INJECT_MARKER in ipc_js,
