        fail("%s: missing expected Electron preload/menu/ipcHandlers files" % asar_archive.path)

    pkg_raw = asar_archive.read_text("package.json")
    app_version = "?"
    if pkg_raw:
        try:
            app_version = json.loads(pkg_raw).get("version", "?")
        except ValueError:
            pass

