class Segment:
    __slots__ = ("offset", "vaddr", "filesz", "flags")

    def __init__(self, offset, vaddr, filesz, flags):
        self.offset = offset
        self.vaddr = vaddr
        self.filesz = filesz
        self.flags = flags


class ElfImage:
    def __init__(self, path, data):
        self.path = path
        self.data = data
        if len(data) < 64 or data[:4] != ELF_MAGIC:
            fail("%s: not an ELF file" % path)
        if data[4] != 2 or data[5] != 1:
            fail("%s: not a 64-bit little-endian ELF file" % path)
        e_type, e_machine = struct.unpack_from("<HH", data, 16)
        if e_type != ET_DYN:
            fail("%s: not a position-independent executable" % path)
        if e_machine != EM_X86_64:
            fail("%s: not an x86-64 binary" % path)
        e_phoff, = struct.unpack_from("<Q", data, 32)
        e_phentsize, e_phnum = struct.unpack_from("<HH", data, 54)
        if e_phentsize != 56:
            fail("%s: unexpected program header size" % path)
        self.segments = []
        self.dynamic = None
        for index in range(e_phnum):
            offset = e_phoff + index * e_phentsize
            if offset + e_phentsize > len(data):
                fail("%s: truncated program header table" % path)
            p_type, p_flags = struct.unpack_from("<II", data, offset)
            p_offset, p_vaddr, _paddr, p_filesz, _memsz, _align = struct.unpack_from(
                "<QQQQQQ", data, offset + 8
            )
            if p_filesz == 0:
                continue
            if p_offset + p_filesz > len(data):
                fail("%s: program header points past end of file" % path)
            self.segments.append(Segment(p_offset, p_vaddr, p_filesz, p_flags))
            if p_type == PT_DYNAMIC:
                self.dynamic = (p_offset, p_filesz)

    def va_to_off(self, vaddr, size=1):
        for segment in self.segments:
            if segment.vaddr <= vaddr and vaddr + size <= segment.vaddr + segment.filesz:
                return segment.offset + (vaddr - segment.vaddr)
        return None

    def off_to_va(self, offset):
        for segment in self.segments:
            if segment.offset <= offset < segment.offset + segment.filesz:
                return segment.vaddr + (offset - segment.offset)
        return None

    def is_executable(self, vaddr, size=1):
        if self.va_to_off(vaddr, size) is None:
            return False
        for segment in self.segments:
            if segment.vaddr <= vaddr and vaddr + size <= segment.vaddr + segment.filesz:
                return bool(segment.flags & PF_X)
        return False

    def read(self, vaddr, size):
        offset = self.va_to_off(vaddr, size)
        if offset is None:
            fail("%s: address 0x%x (+0x%x) is not mapped" % (self.path, vaddr, size))
        return bytes(self.data[offset : offset + size])

    def relative_relocations(self):
        if self.dynamic is None:
            fail("%s: no PT_DYNAMIC segment" % self.path)
        dyn_offset, dyn_size = self.dynamic
        rela_va = None
        rela_size = None
        for index in range(dyn_size // 16):
            tag, value = struct.unpack_from("<QQ", self.data, dyn_offset + index * 16)
            if tag == 0:
                break
            if tag == DT_RELA:
                rela_va = value
            elif tag == DT_RELASZ:
                rela_size = value
        if rela_va is None or rela_size is None:
            fail("%s: no DT_RELA relocation table" % self.path)
        if rela_size % 24:
            fail("%s: malformed DT_RELA table" % self.path)
        table_offset = self.va_to_off(rela_va, rela_size)
        if table_offset is None:
            fail("%s: DT_RELA table is not mapped" % self.path)
        relocations = {}
        mask = (1 << 64) - 1
        for index in range(rela_size // 24):
            entry = table_offset + index * 24
            r_offset, r_info, r_addend = struct.unpack_from(
                "<QQq", self.data, entry
            )
            if (r_info & 0xFFFFFFFF) != R_X86_64_RELATIVE or (r_info >> 32) != 0:
                continue
            relocations[r_offset] = r_addend & mask
        return relocations


class GoImage:
    """Locate the Go pclntab, moduledata and function table of an agy build."""

    def __init__(self, elf):
        self.elf = elf
        data = elf.data
        relocations = elf.relative_relocations()

        candidates = {}
        position = 0
        while True:
            hit = data.find(PCLNTAB_MAGIC, position)
            if hit < 0:
                break
            position = hit + 1
            vaddr = elf.off_to_va(hit)
            if vaddr is None:
                continue
            header = self._parse_pc_header(hit)
            if header is None:
                continue
            if elf.va_to_off(vaddr + header["pcln_offset"]) is None:
                continue
            candidates[vaddr] = header
        if not candidates:
            fail("%s: no Go pclntab header found" % elf.path)

        confirmed = []
        for destination, addend in relocations.items():
            header = candidates.get(addend)
            if header is None:
                continue
            if relocations.get(destination + 8) != addend + header["fname_offset"]:
                continue
            confirmed.append((destination, addend, header))
        if len(confirmed) != 1:
            fail(
                "%s: could not uniquely identify the Go moduledata (%d candidates)"
                % (elf.path, len(confirmed))
            )
        module_va, pcln_va, header = confirmed[0]
        self.module_va = module_va
        self.pcln_va = pcln_va
        self.nfunc = header["nfunc"]
        self.nfiles = header["nfiles"]
        self.fname_offset = header["fname_offset"]
        self.pcln_offset = header["pcln_offset"]
        self.filetab_offset = header["filetab_offset"]
        self.cu_offset = header["cu_offset"]

        def field(offset, name):
            value = relocations.get(module_va + offset)
            if value is None:
                fail("%s: moduledata field %s is not relocated" % (elf.path, name))
            return value

        minpc = field(0xA0, "minpc")
        maxpc = field(0xA8, "maxpc")
        text = field(0xB0, "text")
        etext = field(0xB8, "etext")
        pcln_table = field(0x68, "pclntable")
        ftab_table = field(0x80, "ftab")
        if text != minpc:
            fail("%s: moduledata minpc (0x%x) != text (0x%x)" % (elf.path, minpc, text))
        if not (text < maxpc < etext):
            fail("%s: inconsistent moduledata text range" % elf.path)
        if text % 16:
            fail("%s: text start 0x%x is not 16-byte aligned" % (elf.path, text))
        if not elf.is_executable(text):
            fail("%s: text start 0x%x is not in an executable segment" % (elf.path, text))
        if ftab_table != pcln_va + self.pcln_offset:
            fail("%s: unsupported pclntab layout (ftab relocation mismatch)" % elf.path)
        if pcln_table != ftab_table:
            fail("%s: unsupported pclntab layout (pclntable != ftab)" % elf.path)
        self.text = text
        self.etext = etext
        self.maxpc = maxpc

        ftab_len_offset = elf.va_to_off(module_va + 0x88, 8)
        if ftab_len_offset is None:
            fail("%s: moduledata ftab length is not mapped" % elf.path)
        ftab_len, = struct.unpack_from("<Q", data, ftab_len_offset)
        if ftab_len != self.nfunc + 1:
            fail(
                "%s: unexpected ftab length %d (nfunc=%d)"
                % (elf.path, ftab_len, self.nfunc)
            )
        table_offset = elf.va_to_off(ftab_table, ftab_len * 8)
        if table_offset is None:
            fail("%s: function table is not mapped" % elf.path)
        self.entries = []
        previous = -1
        for index in range(ftab_len):
            entryoff, funcoff = struct.unpack_from(
                "<II", data, table_offset + index * 8
            )
            if entryoff < previous:
                fail("%s: function table is not sorted" % elf.path)
            previous = entryoff
            self.entries.append((entryoff, funcoff))

        fname_va = pcln_va + self.fname_offset
        self.fname_va = fname_va
        self.fname_len = self.cu_offset - self.fname_offset
        if self.fname_len <= 0:
            fail("%s: empty funcnametab" % elf.path)
        self._func_base_va = pcln_table
        for index in range(ftab_len - 1):
            entryoff, funcoff = self.entries[index]
            func_addr = self._func_base_va + funcoff
            func_offset = elf.va_to_off(func_addr, 12)
            if func_offset is None:
                fail("%s: _func entry %d is not mapped" % (elf.path, index))
            recorded, _nameoff = struct.unpack_from("<Ii", data, func_offset)
            if recorded != entryoff:
                fail(
                    "%s: function table entry %d is inconsistent" % (elf.path, index)
                )

    def _parse_pc_header(self, offset):
        data = self.elf.data
        if offset + 8 + 64 > len(data):
            return None
        if data[offset + 6] != 1 or data[offset + 7] != 8:
            return None
        (
            nfunc,
            nfiles,
            _text_start,
            fname_offset,
            cu_offset,
            filetab_offset,
            pctab_offset,
            pcln_offset,
        ) = struct.unpack_from("<8Q", data, offset + 8)
        if not (0 < nfunc < 10_000_000):
            return None
        if not (0 < nfiles < 10_000_000):
            return None
        if not (0 < fname_offset < cu_offset < filetab_offset < pctab_offset < pcln_offset):
            return None
        if pcln_offset > MAX_FILE_SIZE:
            return None
        return {
            "nfunc": nfunc,
            "nfiles": nfiles,
            "fname_offset": fname_offset,
            "cu_offset": cu_offset,
            "filetab_offset": filetab_offset,
            "pcln_offset": pcln_offset,
        }

    def _name_at(self, name_offset):
        if not (0 <= name_offset < self.fname_len):
            fail("%s: function name offset out of range" % self.elf.path)
        base = self.elf.va_to_off(self.fname_va, self.fname_len)
        if base is None:
            fail("%s: funcnametab is not mapped" % self.elf.path)
        start = base + name_offset
        end = self.elf.data.find(b"\0", start, base + self.fname_len)
        if end < 0 or end - start > 65536:
            fail("%s: malformed function name" % self.elf.path)
        try:
            return self.elf.data[start:end].decode("utf-8")
        except UnicodeDecodeError:
            fail("%s: non-UTF-8 function name" % self.elf.path)

    def find_functions(self, wanted):
        found = {name: [] for name in wanted}
        for index in range(len(self.entries) - 1):
            entryoff, funcoff = self.entries[index]
            func_offset = self.elf.va_to_off(
                self._func_base_va + funcoff, 12
            )
            if func_offset is None:
                fail("%s: _func entry %d is not mapped" % (self.elf.path, index))
            _entry, nameoff = struct.unpack_from("<Ii", self.elf.data, func_offset)
            name = self._name_at(nameoff)
            if name in found:
                next_entryoff = self.entries[index + 1][0]
                found[name].append((self.text + entryoff, next_entryoff - entryoff))
        return found

    def summary(self):
        return {
            "functions": self.nfunc,
            "files": self.nfiles,
            "text": "0x%x" % self.text,
            "etext": "0x%x" % self.etext,
            "moduledata": "0x%x" % self.module_va,
        }


