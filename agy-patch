def command_status(args):
    targets = expand_targets(args)
    desktop_dir = None
    if "desktop-context" in targets or "desktop-zh" in targets:
        desktop_dir = resolve_desktop_dir(args.desktop_dir)
    for idx, t in enumerate(targets):
        if idx > 0:
            print("")
        if t == "cli":
            path, real = resolve_binary(args.binary, allow_symlink=True)
            _go_status("cli", path, real, KNOWN_CLI_BUILDS, CLI_PATCH_SPECS)
        elif t == "desktop-context":
            ls_path = os.path.join(desktop_dir, "resources", "bin", "language_server")
            _go_status("desktop-context", ls_path, os.path.realpath(ls_path), KNOWN_LS_BUILDS, LS_PATCH_SPECS)
        elif t == "desktop-zh":
            asar_path = os.path.realpath(os.path.join(desktop_dir, "resources", "app.asar"))
            _zh_status(asar_path)
    return 0


def command_apply(args):
    targets = expand_targets(args)
    desktop_dir = None
    if "desktop-context" in targets or "desktop-zh" in targets:
        desktop_dir = resolve_desktop_dir(args.desktop_dir)
    for idx, t in enumerate(targets):
        if idx > 0:
            print("")
        if t == "cli":
            _path, real = resolve_binary(args.binary, allow_symlink=False)
            _go_apply("cli", real, KNOWN_CLI_BUILDS, CLI_PATCH_SPECS, args.dry_run)
        elif t == "desktop-context":
            ls_path = os.path.realpath(os.path.join(desktop_dir, "resources", "bin", "language_server"))
            _go_apply("desktop-context", ls_path, KNOWN_LS_BUILDS, LS_PATCH_SPECS, args.dry_run, desktop_dir=desktop_dir)
        elif t == "desktop-zh":
            asar_path = os.path.realpath(os.path.join(desktop_dir, "resources", "app.asar"))
            _zh_apply(desktop_dir, asar_path, args.dry_run)
    return 0


def command_restore(args):
    targets = expand_targets(args)
    desktop_dir = None
    if "desktop-context" in targets or "desktop-zh" in targets:
        desktop_dir = resolve_desktop_dir(args.desktop_dir)
    for idx, t in enumerate(targets):
        if idx > 0:
            print("")
        if t == "cli":
            _path, real = resolve_binary(args.binary, allow_symlink=False)
            _restore_file_from_manifest("cli", real)
        elif t == "desktop-context":
            ls_path = os.path.realpath(os.path.join(desktop_dir, "resources", "bin", "language_server"))
            _restore_file_from_manifest("desktop-context", ls_path, desktop_dir=desktop_dir)
        elif t == "desktop-zh":
            asar_path = os.path.realpath(os.path.join(desktop_dir, "resources", "app.asar"))
            _restore_file_from_manifest("desktop-zh", asar_path, desktop_dir=desktop_dir)
    return 0


