PCLNTAB_MAGIC = b"\xf1\xff\xff\xff\x00\x00\x01\x08"
R_X86_64_RELATIVE = 8
ET_DYN = 3
EM_X86_64 = 62
PT_LOAD = 1
PT_DYNAMIC = 2
PF_X = 1
DT_RELA = 7
DT_RELASZ = 8
