        else:
            fail(
                "%s: %s anchor mismatch for %r (old=%d new=%d expected=%d)"
                % (asar_archive.path, rel_path, old[:48], old_cnt, new_cnt, expected_count)
            )

    if not any(markers_present) and all(s == "old" for s in replacement_states):
        state = "pristine"
    elif all(markers_present) and all(s == "new" for s in replacement_states):
        state = "patched"
    else:
        fail("%s: mixed or partial zh-CN localization state" % asar_archive.path)

    replacements = None
    if state == "pristine" and engine_js is not None:
        updated = dict(files_cache)
        updated["dist/preload.js"] = updated["dist/preload.js"] + "\n" + engine_js + "\n"
        updated["dist/ideInstall/wizardPreload.js"] = (
            updated["dist/ideInstall/wizardPreload.js"] + "\n" + engine_js + "\n"
        )
        updated["dist/menu.js"] = updated["dist/menu.js"] + "\n" + MENU_HELPER_JS + "\n"
        updated["dist/ipcHandlers.js"] = (
            updated["dist/ipcHandlers.js"] + "\n" + CONTEXT_MENU_HELPER_JS + "\n"
        )
        for rel_path, old, new, expected_count in ASAR_NATIVE_REPLACEMENTS:
            assert updated[rel_path].count(old) == expected_count
            updated[rel_path] = updated[rel_path].replace(old, new)
        replacements = {k: v.encode("utf-8") for k, v in updated.items()}

    summary = {
        "app_version": app_version,
        "native_edits": len(ASAR_NATIVE_REPLACEMENTS),
        "injected_files": 2 + len({r[0] for r in ASAR_NATIVE_REPLACEMENTS}),
    }
    return state, replacements, summary


# --------------------------------------------------------------------------
# state directory / manifest / backups / process guard
# --------------------------------------------------------------------------


def state_directory():
    override = os.environ.get("AGY_PATCH_STATE_DIR")
    if override:
        return os.path.abspath(override)
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.abspath(os.path.join(base, "agy-patch"))


def manifest_path(state_dir, real_path):
    key = hashlib.sha256(real_path.encode("utf-8")).hexdigest()[:16]
    return os.path.join(state_dir, "manifests", key + ".json")


def load_manifest(state_dir, real_path):
    path = manifest_path(state_dir, real_path)
    if not os.path.exists(path):
        return None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            manifest = json.load(handle)
    except (OSError, ValueError) as error:
        fail("%s: unreadable manifest (%s)" % (path, error))
    if manifest.get("schema") != 1:
        fail("%s: unsupported manifest schema" % path)
    if manifest.get("binary") != real_path:
        fail("%s: manifest belongs to another file" % path)
    manifest["_path"] = path
    return manifest


def ensure_backup(real_path, state_dir, original_sha, source_stat, ext=".bin"):
    backup_dir = os.path.join(state_dir, "backups")
    os.makedirs(backup_dir, exist_ok=True)
    backup_path = os.path.join(backup_dir, original_sha + ext)
    if os.path.exists(backup_path):
        if sha256_file(backup_path) != original_sha:
            fail(
                "%s: existing backup does not match the original file; "
                "refusing to overwrite it" % backup_path
            )
        return backup_path
    temp_path = temp_in_dir(backup_dir, ".backup-")
    try:
        with open(real_path, "rb") as source, open(temp_path, "wb") as target:
            shutil.copyfileobj(source, target, CHUNK)
            target.flush()
            os.fsync(target.fileno())
        os.chmod(temp_path, stat.S_IMODE(source_stat.st_mode))
        if sha256_file(temp_path) != original_sha:
            fail("backup verification failed (source changed during copy)")
        os.replace(temp_path, backup_path)
        fsync_dir(backup_dir)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)
    return backup_path


def assert_unchanged(real_path, original_stat, original_sha):
    current = os.lstat(real_path)
    for attribute in ("st_dev", "st_ino", "st_size", "st_mtime_ns"):
        if getattr(original_stat, attribute) != getattr(current, attribute):
            fail("%s changed while patching; aborting" % real_path)
    if sha256_file(real_path) != original_sha:
        fail("%s content changed while patching; aborting" % real_path)


def check_desktop_not_running(desktop_dir):
    real_desktop = os.path.realpath(desktop_dir)
    if not os.path.isdir("/proc"):
        return
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        exe_link = os.path.join("/proc", entry, "exe")
        try:
            exe_target = os.path.realpath(exe_link)
        except OSError:
            continue
        if exe_target == real_desktop or exe_target.startswith(real_desktop + os.sep):
            fail(
                "Antigravity Desktop is currently running (pid %s: %s); "
                "close it completely before patching or restoring" % (entry, exe_target)
            )


