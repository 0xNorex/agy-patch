def _print_manifest_status(state_dir, real, state, digest):
    manifest = load_manifest(state_dir, real)
    if manifest is None:
        print("manifest: none")
        return
    print("manifest: %s" % manifest["_path"])
    print("  created: %s" % manifest.get("created_at", "?"))
    if state == "patched":
        if digest == manifest.get("patched_sha256"):
            print("  status:  verified against this build")
        else:
            print("  status:  STALE (file hash does not match manifest)")
    else:
        print("  status:  stale (file is not the patched build)")
    backup_path = manifest.get("backup", "")
    if os.path.exists(backup_path):
        if sha256_file(backup_path) == manifest.get("original_sha256"):
            print("backup:   %s (sha256 verified)" % backup_path)
        else:
            print("backup:   %s (CHECKSUM MISMATCH)" % backup_path)
    else:
        print("backup:   %s (missing)" % backup_path)
    print("original: %s" % manifest.get("original_sha256", "?"))
    print("patched:  %s" % manifest.get("patched_sha256", "?"))


def _print_edits(edits):
    for edit in edits:
        print(
            "  %-62s va=0x%x offset=0x%x %s -> %s"
            % (
                edit.symbol.rsplit(".", 1)[-1],
                edit.va,
                edit.offset,
                edit.old.hex(),
                edit.new.hex(),
            )
        )


def _go_status(label, path, real, known_builds, specs):
    digest = sha256_file(real)
    with open(real, "rb") as handle:
        mapping = mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ)
        try:
            elf = ElfImage(real, mapping)
            go = GoImage(elf)
            state, _edits, _funcs = analyze_go_specs(go, specs)
            summary = go.summary()
        finally:
            mapping.close()

    print("[%s]" % label)
    print("binary:   %s" % real)
    print("sha256:   %s" % digest)
    if real != path:
        print("symlink:  %s -> %s" % (path, real))
    print(
        "go table: %d functions, %d files, text=%s, etext=%s"
        % (summary["functions"], summary["files"], summary["text"], summary["etext"])
    )
    if state == "pristine":
        print("state:    pristine (%s; not patched)" % (
            "verified " + known_builds[digest] if digest in known_builds
            else "signature-compatible, UNVERIFIED build"
        ))
    else:
        print("state:    patched (%d byte edits present)" % len(specs))
    _print_manifest_status(state_directory(), real, state, digest)


def _go_apply(label, real, known_builds, specs, dry_run, desktop_dir=None):
    source_stat = os.lstat(real)
    current_sha = sha256_file(real)
    state_dir = state_directory()
    manifest = load_manifest(state_dir, real)

    with open(real, "rb") as handle:
        mapping = mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ)
        try:
            elf = ElfImage(real, mapping)
            go = GoImage(elf)
            state, edits, _funcs = analyze_go_specs(go, specs)
            summary = go.summary()
        finally:
            mapping.close()

    print("[%s]" % label)
    if state == "patched":
        if manifest is None:
            fail("%s: binary is already patched but the manifest is missing; refusing to continue" % real)
        if current_sha != manifest.get("patched_sha256"):
            fail("%s: binary is patched but does not match the manifest; refusing to continue" % real)
        print("already patched: %s" % real)
        print("sha256:          %s (matches manifest)" % current_sha)
        return
    if current_sha not in known_builds:
        fail("%s: unverified original SHA256 %s; refusing unknown build" % (real, current_sha))
    if manifest is not None and manifest.get("original_sha256") != current_sha:
        print("warning: an older manifest exists for a different build; it will be replaced")

    if desktop_dir and not dry_run:
        check_desktop_not_running(desktop_dir)

    original_sha = current_sha
    patched_sha = sha256_with_edits(real, edits)
    print("binary:   %s" % real)
    print("go table: %d functions, text=%s" % (summary["functions"], summary["text"]))
    print("edits:    %d byte replacements" % len(edits))
    _print_edits(edits)
    print("sha256:   %s -> %s" % (original_sha, patched_sha))
    if dry_run:
        print("dry-run:  no files were written")
        return

    backup_path = ensure_backup(real, state_dir, original_sha, source_stat, ext=".bin")
    print("backup:   %s (sha256 verified)" % backup_path)

    directory = os.path.dirname(real)
    temp_path = temp_in_dir(directory, ".agy-patch-")
    try:
        write_patched(real, temp_path, edits, source_stat)
        if sha256_file(temp_path) != patched_sha:
            fail("patched temporary file failed checksum verification")
        assert_unchanged(real, source_stat, original_sha)
        os.replace(temp_path, real)
        fsync_dir(directory)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)

    final_sha = sha256_file(real)
    if final_sha != patched_sha:
        fail("%s: post-write checksum mismatch (%s)" % (real, final_sha))

    manifest_payload = {
        "schema": 1,
        "tool": "agy-patch",
        "target": label,
        "binary": real,
        "binary_size": source_stat.st_size,
        "original_sha256": original_sha,
        "patched_sha256": patched_sha,
        "backup": backup_path,
        "backup_sha256": original_sha,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "edits": [
            {
                "label": edit.label,
                "symbol": edit.symbol,
                "va": "0x%x" % edit.va,
                "offset": edit.offset,
                "old": edit.old.hex(),
                "new": edit.new.hex(),
            }
            for edit in edits
        ],
    }
    atomic_write_json(manifest_path(state_dir, real), manifest_payload)
    print("patched:  %s" % real)
    print("manifest: %s" % manifest_path(state_dir, real))


def _restore_file_from_manifest(label, real, desktop_dir=None):
    state_dir = state_directory()
    manifest = load_manifest(state_dir, real)
    print("[%s]" % label)
    if manifest is None:
        fail("%s: no manifest found; nothing to restore" % real)
    live_sha = sha256_file(real)
    if live_sha == manifest.get("original_sha256"):
        fail("%s: file already matches the original; nothing to restore" % real)
    if live_sha != manifest.get("patched_sha256"):
        fail(
            "%s: live file hash %s does not match the patched hash in the manifest; "
            "refusing to overwrite a file changed after patching" % (real, live_sha)
        )
    backup_path = manifest.get("backup", "")
    if not os.path.exists(backup_path):
        fail("%s: backup is missing; cannot restore" % backup_path)
    backup_sha = sha256_file(backup_path)
    if backup_sha != manifest.get("original_sha256"):
        fail(
            "%s: backup checksum mismatch (expected %s, got %s); refusing to restore"
            % (backup_path, manifest.get("original_sha256"), backup_sha)
        )
    if desktop_dir:
        check_desktop_not_running(desktop_dir)

    current_stat = os.lstat(real)
    directory = os.path.dirname(real)
    temp_path = temp_in_dir(directory, ".agy-restore-")
    try:
        with open(backup_path, "rb") as source, open(temp_path, "wb") as target:
            shutil.copyfileobj(source, target, CHUNK)
            target.flush()
            os.fsync(target.fileno())
        os.chmod(temp_path, stat.S_IMODE(current_stat.st_mode))
        if sha256_file(temp_path) != backup_sha:
            fail("restored temporary file failed checksum verification")
        assert_unchanged(real, current_stat, live_sha)
        os.replace(temp_path, real)
        fsync_dir(directory)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)
    final_sha = sha256_file(real)
    if final_sha != backup_sha:
        fail("%s: post-restore checksum mismatch" % real)
    try:
        os.unlink(manifest["_path"])
        fsync_dir(os.path.dirname(manifest["_path"]))
    except OSError:
        pass
    print("restored: %s" % real)
    print("sha256:   %s (original)" % final_sha)
    print("backup:   %s (kept)" % backup_path)


